<section class="mx-auto max-w-2xl space-6">
  <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold text-gray-800">
      お問い合わせ
    </h1>

    <p class="mt-2 text-sm leading-6 text-gray-600">
      ファミリーステップに関するご質問やご意見をお送りください。
    </p>

    <div class="mt-6">
      <%= render "shared/error_messages", object: @contact %>
    </div>

    <%= form_with model: @contact, url: contact_path, local: true, class: "mt-8 space-y-6" do |form| %>

      <div>
        <%= form.label :name,
                       "お名前",
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :name,
                            autocomplete: "name",
                            class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800 shadow-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>
      </div>

      <div>
        <%= form.label :email,
                       "メールアドレス",
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.email_field :email,
                             autocomplete: "email",
                             class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800 shadow-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>
      </div>

      <div>
        <%= form.label :message,
                       "お問い合わせ内容",
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_area :message,
                           rows: 8,
                           class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800 shadow-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>

        <p class="mt-2 text-xs text-gray-500">
          10文字以上、1,000文字以内で入力してください。
        </p>
      </div>

      <%= form.submit "お問い合わせを送信",
                      class: "w-full rounded-xl bg-teal-600 px-6 py-3 font-bold text-white shadow-sm transition hover:bg-teal-700" %>
    <% end %>
  </div>
</section>
