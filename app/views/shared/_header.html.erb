<header class="fixed top-0 left-0 right-0 z-30 border-b bg-white" data-controller="menu">
  <div class="flex items-center justify-between px-4 py-3">
    <%= link_to "ファミリーステップ", dashboard_path, class: "text-lg font-semibold" %>

    <button type="button" class="rounded p-2 text-2xl" data-action="click->menu#open" aria-label="メニューを開く">
      ☰
    </button>
  </div>

  <div class="fixed inset-0 z-40 hidden bg-black/50" data-menu-target="overlay" data-action="click->menu#close"></div>

  <div class="fixed top-0 right-0 z-50 hidden h-full flex flex-col w-64 bg-white shadow-lg" data-menu-target="panel">
    <div class="flex items-center justify-between border-b px-4 py-3">
      <% if user_signed_in? %>
        <p class="font-semibold"><%= current_user.name %></p>
      <% else %>
        <p class="font-semibold">メニュー</p>
      <% end %>

      <button type="button" class="rounded p-2" data-action="click->menu#close" aria-label="メニューを閉じる">
        ✖️
      </button>
    </div>

    <div class="flex-1 flex flex-col justify-between p-4">
      <div class="space-y-4">
        <% if user_signed_in? %>
          <nav class="flex flex-col space-y-1">
            <%= link_to dashboard_path,
                class: "flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-gray-700 transition hover:bg-gray-100" do %>
              <%= render "shared/menu_icon", icon_name: "home" %>
              <span>ホーム</span>
            <% end %>

            <%= link_to mypage_path,
                class: "flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-gray-700 transition hover:bg-gray-100" do %>
              <%= render "shared/menu_icon", icon_name: "user-circle" %>
              <span>マイページ</span>
            <% end %>

            <%= link_to groups_path,
                class: "flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-gray-700 transition hover:bg-gray-100" do %>
              <%= render "shared/menu_icon", icon_name: "user-group" %>
              <span>グループ一覧</span>
            <% end %>

            <%= link_to new_group_path,
                class: "flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-gray-700 transition hover:bg-gray-100" do %>
              <%= render "shared/menu_icon", icon_name: "user-plus" %>
              <span>グループ作成</span>
            <% end %>

            <%= link_to notifications_path,
                class: "flex min-h-10 items-center gap-3 rounded-lg px-3 py-1.5 text-left text-gray-700 transition hover:bg-gray-100" do %>

              <%= render "shared/menu_icon", icon_name: "bell" %>

              <span class="flex-1">
                通知一覧
              </span>

              <% unread_count = current_user.notifications.unread.count %>
              <% if unread_count.positive? %>
                <span class="rounded-full bg-red-500 px-2 py-0.5 text-xs font-semibold text-white">
                  <%= unread_count %>
                </span>
              <% end %>
            <% end %>
          </nav>
        <% end %>

        <div class="mt-6">
          <p class="px-3 text-xs font-semibold text-gray-400">
            サポート・情報
          </p>

          <div class="mt-2 space-y-1">
            <%= link_to usage_path,
                class: "flex min-h-10 items-center gap-3 rounded-lg px-3 py-1.5 text-left text-gray-700 transition hover:bg-gray-100" do %>
              <%= render "shared/menu_icon", icon_name: "question-mark-circle" %>
              <span>使い方</span>
            <% end %>

            <div
              class="flex min-h-10 items-center gap-3 rounded-lg px-3 py-1.5 text-gray-400"
              aria-disabled="true"
            >
              <%= render "shared/menu_icon", icon_name: "envelope" %>

              <span class="flex-1">
                お問い合わせ
              </span>

              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
                準備中
              </span>
            </div>

            <div
              class="flex min-h-10 items-center gap-3 rounded-lg px-3 py-1.5 text-gray-400"
              aria-disabled="true"
            >
              <%= render "shared/menu_icon", icon_name: "document-text" %>

              <span class="flex-1">
                利用規約
              </span>

              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
                準備中
              </span>
            </div>

            <div
              class="flex min-h-10 items-center gap-3 rounded-lg px-3 py-1.5 text-gray-400"
              aria-disabled="true"
            >
              <%= render "shared/menu_icon", icon_name: "shield-check" %>

              <span class="flex-1">
                プライバシーポリシー
              </span>

              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
                準備中
              </span>
            </div>
          </div>
        </div>
      </div>

      <div>
        <% if user_signed_in? %>
          <%= link_to destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "flex min-h-10 items-center justify-center gap-2 rounded-full bg-red-100 px-4 py-2 font-medium text-red-600 transition hover:bg-red-200" do %>

            <%= render "shared/menu_icon", icon_name: "arrow-left-start-on-rectangle" %>

            <span>ログアウト</span>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path,
              class: "flex min-h-10 items-center justify-center gap-2 rounded-full bg-teal-600 px-4 py-2 font-medium text-white transition hover:bg-teal-700" do %>

            <%= render "shared/menu_icon", icon_name: "arrow-right-end-on-rectangle" %>

            <span>ログイン</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</header>
