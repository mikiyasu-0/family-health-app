<% set_meta_tags(top_page_meta_tags) unless user_signed_in? %>

<% content_for :main_class,
               "w-full max-w-none pt-16" %>

<section class="w-full bg-lime-50">
  <picture>
    <source
      media="(min-width: 768px)"
      srcset="<%= asset_path('ogp/family_step_hero_pc.png') %>"
    >

    <%= image_tag "ogp/family_step_hero_mobile.png",
                  class: "mx-auto block h-auto w-full",
                  alt: "ファミリーステップ" %>
  </picture>
</section>

<section class="bg-lime-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="text-center text-3xl font-bold text-gray-800">
      ファミリーステップ
    </h1>

     <p class="mt-4 text-center text-lg text-gray-700">
      離れて暮らす家族と、運動習慣をゆるく見守るアプリです。
    </p>

    <div class="mt-8 flex flex-col items-center gap-4">
      <div class="flex flex-col items-center gap-4 sm:flex-row">
        <%= link_to "新規登録",
                    new_user_registration_path,
                    class: "rounded-2xl bg-teal-600 px-10 py-5 text-xl font-bold text-white shadow-sm transition hover:bg-teal-700" %>

        <%= link_to "ログイン",
                    new_user_session_path,
                    class: "rounded-2xl border-2 border-teal-600 bg-white px-10 py-5 text-xl font-bold text-teal-700 transition hover:bg-teal-50" %>
      </div>

      <div class="w-full max-w-md">
        <%= button_to guest_login_path,
                      method: :post,
                      form_class: "w-full",
                      class: "w-full rounded-2xl bg-teal-500 px-6 py-4 text-lg font-bold text-white shadow-md transition hover:bg-teal-600" do %>
          ゲストログインで試す
        <% end %>

        <p class="mt-3 text-center text-sm font-medium text-gray-500">
          登録せずにアプリの画面をお試しいただけます。
        </p>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
        <div class="flex justify-center text-teal-600">
          <%= render "shared/icon", name: "heart" %>
        </div>

        <h2 class="mt-4 text-xl font-bold text-gray-800">
          アプリの目的
        </h2>

        <p class="mt-3 leading-relaxed text-gray-600">
          離れて暮らす家族と運動習慣を共有し、
          お互いにゆるく見守りながら続けられることを目指しています。
        </p>
      </div>

      <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
        <div class="flex justify-center text-teal-600">
          <%= render "shared/icon", name: "user-group" %>
        </div>

        <h2 class="mt-4 text-xl font-bold text-gray-800">
          できること
        </h2>

        <p class="mt-3 leading-relaxed text-gray-600">
          運動を記録したり、家族の記録にリアクションやコメントを送ったりできます。
          離れていても、家族の頑張りをゆるく見守れます。
        </p>
      </div>

      <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
        <div class="flex justify-center text-teal-600">
          <%= render "shared/icon", name: "question-mark-circle" %>
        </div>

        <h2 class="mt-4 text-xl font-bold text-gray-800">
          使い方
        </h2>

        <p class="mt-3 leading-relaxed text-gray-600">
          運動項目を押すだけで簡単に記録できます。
          初めての方でも迷わず使えるよう、操作方法を紹介しています。
        </p>

        <%= link_to "使い方を見る →",
                    usage_path,
                    class: "mt-5 inline-block font-bold text-teal-700 hover:text-teal-800 hover:underline" %>
      </div>
    </div>
  </div>
</section>
