<section class="space-y-4">
  <h1 class="text-2xl font-bold">今日の運動を記録する</h1>

  <div class="rounded-xl bg-orange-100 px-4 py-3 text-sm text-gray-700">
    <p>
      下の項目を押すと、今日の記録として保存され、家族にも共有されます。
    </p>
    <p class="mt-1">
      記録後は、今日の体調や感じたことをメモできます（任意）。
    </p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <% exercise_types.each do |exercise_type| %>
      <% today_record = today_exercise_records.find { |record| record.exercise_type == exercise_type } %>

      <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <% if today_record.present? %>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-lg font-bold text-gray-800">
              <% case exercise_type %>
              <% when "walk" %>
                散歩
              <% when "chair_squat" %>
                椅子スクワット
              <% when "heel_raise" %>
                かかと上げ
              <% when "rest" %>
                休み
              <% end %>
            </p>
            <p class="shrink-0 rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-700">
              記録済み
            </p>
          </div>

          <%= form_with model: today_record, local: true do |f| %>
          <%= render "shared/error_messages", object: today_record %>

            <div>
              <%= f.text_area :memo,
                  rows: 2,
                  placeholder: "今日の体調や感じたことを入力（任意）",
                  class: "mt-3 w-full rounded-lg border border-gray-300 p-3 text-sm transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>
            </div>
            <div>
              <%= f.submit "メモを保存",
                  class: "mt-3 rounded-lg bg-teal-600 px-4 py-2 text-sm font-medium text-white shadow-md transition hover:bg-teal-700 active:scale-95 focus:outline-none focus:ring-2 focus:ring-teal-300" %>
            </div>
          <% end %>
        <% else %>
          <%= button_to exercise_records_path,
              method: :post,
              params: { exercise_record: { exercise_type: exercise_type } },
              form_class: "w-full",
              class: "flex min-h-32 w-full flex-col items-center justify-center rounded-xl border border-orange-500 bg-orange-500 p-4 text-center text-white shadow-md transition hover:bg-orange-600 active:scale-95 focus:outline-none focus:ring-2 focus:ring-orange-300 focus:ring-offset-2" do %>

            <span class="text-lg font-bold">
              <% case exercise_type %>
              <% when "walk" %>
                散歩
              <% when "chair_squat" %>
                椅子スクワット
              <% when "heel_raise" %>
                かかと上げ
              <% when "rest" %>
                休み
              <% end %>
            </span>

            <span class="mt-2 text-sm text-orange-50">
              押して記録
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
