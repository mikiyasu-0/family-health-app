<section class="overflow-hidden rounded-2xl border border-teal-200 bg-white shadow-sm">
  <header class="border-b border-teal-200 bg-teal-50 px-4 py-4">
    <h2 class="text-xl font-bold text-gray-900">
      <%= user.name %>さんの今日の運動記録
    </h2>

    <p class="mt-1 text-sm text-gray-600">
      今日記録した運動や、家族から届いたリアクションを確認できます。
    </p>
  </header>

  <% if today_exercise_records.any? %>
    <div class="divide-y divide-gray-200">
      <% exercise_types.each do |exercise_type| %>
        <% today_record = today_exercise_records.find { |record| record.exercise_type == exercise_type } %>

        <% if today_record.present? %>
          <article class="px-4 py-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-bold text-gray-800">
                <% case exercise_type %>
                <% when "walk" %>
                  散歩
                <% when "chair_squat" %>
                  椅子スクワット
                <% when "heel_raise" %>
                  かかと上げ
                <% when "rest" %>
                  休み
                <% end %>
              </h3>

              <div class="flex flex-wrap gap-2">
                <% Reaction::REACTION_TYPES.each do |reaction_type| %>
                  <% count = today_record.reactions.where(reaction_type: reaction_type).count %>

                  <% if count > 0 %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-1 text-sm font-medium text-gray-700">
                      <%= render "shared/reaction_icon",
                                 reaction_type: reaction_type %>
                      <%= count %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>

            <p class="mt-2 text-sm text-gray-600">
              <%= today_record.memo.presence || "メモはありません" %>
            </p>

            <div class="mt-3">
              <%= render "comments/comment_list",
                         exercise_record: today_record %>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="p-4">
      <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-500">
        今日はまだ運動記録がありません
      </p>
    </div>
  <% end %>
</section>
