  <section class="space-y-4">
    <h2 class="text-xl font-bold text-gray-900">
      <%= current_user.name %>さんの今日の運動記録
    </h2>

    <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
      <% if today_exercise_records.any? %>
        <% exercise_types.each do |exercise_type| %>
          <% today_record = today_exercise_records.find { |record| record.exercise_type == exercise_type } %>

          <% if today_record.present? %>
            <div class=" border-t border-gray-100 py-3">
              <p class="text-base font-semibold text-gray-800">
                <% case exercise_type %>
                <% when "walk" %>
                  散歩
                <% when "chair_squat" %>
                  椅子スクワット
                <% when "heel_raise" %>
                  かかと上げ
                <% when "rest" %>
                  休み
                <% end %>
              </p>

              <p class="mt-1 text-sm text-gray-600">
                <%= today_record.memo.presence || "メモはありません" %>
              </p>

              <div class="mt-2 flex gap-3">
                <% Reaction::REACTION_TYPES.each do |reaction_type| %>
                  <% count = today_record.reactions.where(reaction_type: reaction_type).count %>
                  
                  <% if count > 0 %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-1 text-sm font-medium text-gray-700">
                      <%= render "shared/reaction_icon", reaction_type: reaction_type %>
                      <%= count %>
                    </span>
                  <% end %>
                <% end %>
              </div>

            <%= render "comments/comment_list", exercise_record: today_record %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">今日はまだ運動記録がありません</p>
      <% end %>
    </div>
  </section>
