<div class="mx-auto max-w-2xl space-y-8 p-4">

  <%= render "activity_summary",
             current_streak: @current_streak,
             longest_streak: @longest_streak,
             streak_badge: @streak_badge,
             weekly_summary: @weekly_summary %>

  <%= render "exercise_record_section",
             exercise_types: @exercise_types,
             today_exercise_records: @today_exercise_records %>

  <%= render "body_memo_card", body_memo: @body_memo %>

  <%= render "current_user_records",
             user: current_user,
             exercise_types: @exercise_types,
             today_exercise_records: @today_exercise_records %>

  <%= render "family_records",
             user: current_user,
             group_members: @group_members,
             group_members_today_records: @group_members_today_records,
             records_by_user: @records_by_user,
             exercise_types: @exercise_types %>
</div>
